# Generate using: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-value
DATABASE_PATH=data/rentalcar.db
# Set to 1 when HTTPS is terminated by the reverse proxy.
COOKIE_SECURE=0
# Optional ERP integration key. Leave unset until the integration is enabled.
ERP_API_KEY=
